NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://lumina-workflow.vercel.app/workflow

# Nur serverseitig verwenden; niemals mit NEXT_PUBLIC_ beginnen lassen
OPENAI_API_KEY=your-openai-api-key
OPENAI_ASSISTANT_MODEL=gpt-5.6-terra

# Server-seitiger IONOS-Versand für rollenbezogene Aufgabenmails
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@volkerkusch.de
SMTP_PASSWORD=your-ionos-mailbox-password
SMTP_FROM=LUMINA Workflow <info@volkerkusch.de>
