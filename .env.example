NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://lumina-workflow.vercel.app/workflow

# Serverseitiger KAI-Quickstart (niemals NEXT_PUBLIC_ verwenden)
LUMINA_QUICKSTART_ENABLED=false
LUMINA_QUICKSTART_EMAIL=quickstart@example.com
LUMINA_QUICKSTART_PASSWORD=replace-with-a-strong-server-only-password

# Server-seitiger IONOS-Versand für rollenbezogene Aufgabenmails
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@volkerkusch.de
SMTP_PASSWORD=your-ionos-mailbox-password
SMTP_FROM=LUMINA Workflow <info@volkerkusch.de>

# Server-seitig für KAI/KIRA KI-Assistenten (niemals NEXT_PUBLIC_ verwenden)
OPENAI_API_KEY=your-openai-api-key
LUMINA_AI_MODEL=gpt-5-mini

# Optionale Kostenschätzung für KAI/KIRA. Defaults im Code entsprechen gpt-5-mini.
# Preise in USD je 1 Mio. Token; USD/EUR ist nur ein Schätzkurs und kann in Vercel aktualisiert werden.
LUMINA_AI_INPUT_USD_PER_M=0.25
LUMINA_AI_CACHED_INPUT_USD_PER_M=0.025
LUMINA_AI_OUTPUT_USD_PER_M=2.00
LUMINA_USD_TO_EUR=0.879
